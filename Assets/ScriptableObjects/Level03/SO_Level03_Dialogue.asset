  - id: hatch_open
    text: "Ah\xED abajo..."
    duration: 2.5
    voice: {fileID: 0}
  - id: magnet_move
    text: Se mueve...
    duration: 2.5
    voice: {fileID: 0}
  - id: paint_need
    text: No se mueve...
    duration: 2.5
    voice: {fileID: 0}
  - id: credential_pickup
    text: Esto puede servir...
    duration: 2.5
