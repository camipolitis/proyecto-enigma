--- !u!102 &1872191328
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1872191326}
  m_Text: "Lo que hoy se susurra en este cuarto\nma\xF1ana lo oir\xE1n todas las
    banderas.\nQuerr\xE1n torcer el tiempo a su favor\ny el cielo, sempiterno, guardar\xE1
    la ceniza;\ncada ciudad ser\xE1 un cad\xE1ver que todav\xEDa respira.\nNo es
    pigricia lo que me detiene:\nes saber que ya empez\xF3.\n\n\u2014 Panizza"
  m_OffsetZ: 0
  m_CharacterSize: 0.0052
  m_LineSpacing: 0.95
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 64
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 12800000, guid: aec4602539e92dd4dad4d5e1d7370ff3, type: 3}
